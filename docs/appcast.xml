---
include_prereleases: false
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" xmlns:dc="http://purl.org/dc/elements/1.1/">
    <channel>
        <title>{{ site.github.project_title }} Appcast Feed</title>
        <description>Most recent changes with links to updates.</description>
        <language>en</language>
        {% for release in site.github.releases %}
            {% if release.prerelease and page.include_prereleases != true %}{% continue %}{% endif %}

            {% assign version = release.tag_name %}
            {% assign asset_url = "" %}
            {% assign asset_size = "" %}
            {% for asset in release.assets %}
                {% if asset.name == "GitX.dmg" %}
                    {% assign asset_url = asset.browser_download_url %}
                    {% assign asset_size = asset.size %}
                {% endif %}
            {% endfor %}

            {% comment %} The release job writes the EdDSA signature into the release notes as a marker line. {% endcomment %}
            {% assign signature_parts = release.body | split: "<!-- sparkle-edSignature: " %}
            {% assign signature_end = signature_parts[1] | split: " -->" %}
            {% assign signature = signature_end[0] %}

            {% if asset_url != "" and signature != nil and signature != "" %}
            <item>
                <title>{{ release.name }}</title>
                <description><![CDATA[{{ release.body | markdownify }}]]></description>
                <pubDate>{{ release.published_at | date_to_rfc822 }}</pubDate>
                <sparkle:version>{{ version }}</sparkle:version>
                <sparkle:shortVersionString>{{ version }}</sparkle:shortVersionString>
                <enclosure
                    url="{{ asset_url }}"
                    length="{{ asset_size }}"
                    type="application/octet-stream"
                    sparkle:edSignature="{{ signature }}"
                />
                <link>{{ release.html_url }}</link>
            </item>
            {% endif %}
        {% endfor %}
    </channel>
</rss>
